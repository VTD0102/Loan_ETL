# --- CUSTOM PROJECT RULES ---

# Ignore virtual environments
venv/
.venv/
env/

# Ignore python cache
__pycache__/
*.py[cod]

# Data files (Chặn dữ liệu thô vì nó rất nặng)
data/raw/*.csv

# Database & Sensitive configs
# config/settings.yaml  <-- Bỏ comment nếu bạn MUỐN chặn, nhưng khuyên là nên để lại để người khác có mẫu cấu hình

# ML Models (Bỏ comment dòng dưới nếu bạn muốn CHẶN không cho upload model lên GitHub)
# *.pkl 

# Documentation build
docs/_build/

# IDE
.vscode/
.idea/
