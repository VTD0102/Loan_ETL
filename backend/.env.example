# Database (Supabase)
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_db_password_here

# Bureau / CIC Database (Supabase - cic_project)
# If omitted, the app falls back to the loan DB above (CIC reads from the same DB).
BUREAU_DB_HOST=your-cic-supabase-host.pooler.supabase.com
BUREAU_DB_PORT=6543
BUREAU_DB_NAME=postgres
BUREAU_DB_USER=postgres.your_cic_project_ref
BUREAU_DB_PASSWORD=your_db_password_here

# JWT
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your_key_here
RAG_LLM_MODEL=google/gemini-2.5-flash
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_TOP_K=4

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=None
QDRANT_COLLECTION=creditintel-kb
